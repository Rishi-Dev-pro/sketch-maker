{
  "name": "sketch-maker-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Photo-to-Procedural-Art monorepo: High-precision progressively drawn procedural artwork from photographs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:dataset && npm run test:preprocess && npm run test:segmentation && npm run test:face-region && npm run test:eyes && npm run test:eyebrows && npm run test:nose && npm run test:mouth && npm run test:jawline && npm run test:ears && npm run test:hair && npm run test:provider && npm run test:mediapipe:mapper && npm run test:mediapipe:pose && npm run test:mediapipe:segmenter && npm run test:geometry && npm run test:strokes && npm run test:ordering && npm run test:timeline && npm run test:renderer && npm run test --workspaces --if-present",
    "test:dataset": "node tests/images/validate.js",
    "test:preprocess": "tsx tests/image-processing/preprocess.test.ts",
    "test:segmentation": "tsx tests/structural-analysis/segmentation.test.ts",
    "test:face-region": "tsx tests/structural-analysis/face-region.test.ts",
    "test:eyes": "tsx tests/structural-analysis/eyes.test.ts",
    "test:eyebrows": "tsx tests/structural-analysis/eyebrows.test.ts",
    "test:nose": "tsx tests/structural-analysis/nose.test.ts",
    "test:mouth": "tsx tests/structural-analysis/mouth.test.ts",
    "test:jawline": "tsx tests/structural-analysis/jawline.test.ts",
    "test:ears": "tsx tests/structural-analysis/ears.test.ts",
    "test:hair": "tsx tests/structural-analysis/hair.test.ts",
    "test:provider": "tsx tests/structural-analysis/vision-provider.test.ts",
    "test:mediapipe:mapper": "tsx tests/structural-analysis/mediapipe-landmark-mapper.test.ts",
    "test:mediapipe:pose": "tsx tests/structural-analysis/mediapipe-pose-mapper.test.ts",
    "test:mediapipe:segmenter": "tsx tests/structural-analysis/mediapipe-segmenter-mapper.test.ts",
    "test:geometry": "tsx tests/stroke-engine/geometry.test.ts",
    "test:strokes": "tsx tests/stroke-engine/stroke-candidate.test.ts",
    "test:ordering": "tsx tests/stroke-engine/stroke-ordering.test.ts",
    "test:timeline": "tsx tests/stroke-engine/stroke-timeline.test.ts",
    "test:renderer": "tsx tests/stroke-engine/procedural-renderer.test.ts",

    "benchmark:image-processing": "tsx tests/image-processing/benchmark-runner.ts",
    "benchmark:segmentation": "tsx tests/structural-analysis/visual-inspector.ts",
    "benchmark:pose": "tsx tests/structural-analysis/pose-inspector.ts",
    "benchmark:eyes": "tsx tests/structural-analysis/eye-inspector.ts",
    "benchmark:eyebrows": "tsx tests/structural-analysis/eyebrow-inspector.ts",
    "benchmark:eyebrows:audit": "tsx tests/structural-analysis/audit-eyebrows.ts",
    "benchmark:nose": "tsx tests/structural-analysis/nose-inspector.ts",
    "benchmark:mouth": "tsx tests/structural-analysis/mouth-inspector.ts",
    "benchmark:jawline": "tsx tests/structural-analysis/jawline-inspector.ts",
    "benchmark:ears": "tsx tests/structural-analysis/ear-inspector.ts",
    "benchmark:hair": "tsx tests/structural-analysis/hair-inspector.ts",
    "benchmark:geometry": "tsx tests/benchmarks/geometry-benchmark.ts",
    "benchmark:strokes": "tsx tests/benchmarks/stroke-candidate-benchmark.ts",
    "benchmark:ordering": "tsx tests/benchmarks/stroke-ordering-benchmark.ts",
    "benchmark:timeline": "tsx tests/benchmarks/stroke-timeline-benchmark.ts",
    "benchmark:renderer": "tsx tests/benchmarks/renderer-benchmark.ts",
    "lint": "npm run lint --workspaces --if-present",

    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "procedural-art",
    "generative-art",
    "vector-strokes",
    "canvas",
    "creative-coding"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
