{
  "name": "sketch-maker-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Photo-to-Procedural-Art monorepo: High-precision progressively drawn procedural artwork from photographs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "procedural-art",
    "generative-art",
    "vector-strokes",
    "canvas",
    "creative-coding"
  ],
  "author": "",
  "license": "UNLICENSED"
}
